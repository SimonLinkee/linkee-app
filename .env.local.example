NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Secret server-side key (Supabase â†’ Settings â†’ API Keys â†’ secret key). NEVER prefix with NEXT_PUBLIC_.
# Only used by /api/admin/accounts to create accounts and reset passwords.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
