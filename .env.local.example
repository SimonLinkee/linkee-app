NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Secret server-side key (Supabase → Settings → API Keys → secret key). NEVER prefix with NEXT_PUBLIC_.
# Only used by /api/admin/accounts to create accounts and reset passwords.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
# Optional — better road routing (free key at openrouteservice.org). Without it the public OSRM server is used.
ORS_API_KEY=your-ors-key
# Vercel Cron sends this secret to /api/cron/backup (set the same value in Vercel)
CRON_SECRET=a-long-random-string

# Exp�rimentation : position du camion de Lyon (jeton du lien public du tracker Invoxia). SECRET : le d�p�t est public, ne jamais le mettre dans le code.
INVOXIA_TRACKER_LYON=

# Envoi des Cerfa par mail. Au choix : (1) une boîte mail existante par SMTP, ou (2) Resend (https://resend.com, domaine à vérifier)
# (1) boîte mail, ex. Google Workspace : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=simon@linkee.co, SMTP_PASS=<mot de passe d'application>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# (2) Resend
RESEND_API_KEY=
MAIL_FROM=Linkee <cerfa@linkee.co>
# MAIL_REPLY_TO=compta@linkee.co
