NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Secret server-side key (Supabase → Settings → API Keys → secret key). NEVER prefix with NEXT_PUBLIC_.
# Only used by /api/admin/accounts to create accounts and reset passwords.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
# Optional — e-mail copies of notifications (https://resend.com). Without it, only the in-app bell is used.
RESEND_API_KEY=your-resend-key
NOTIFY_FROM=Linkee <notifications@your-domain>
# Optional — better road routing (free key at openrouteservice.org). Without it the public OSRM server is used.
ORS_API_KEY=your-ors-key
# Vercel Cron sends this secret to /api/cron/backup (set the same value in Vercel)
CRON_SECRET=a-long-random-string
